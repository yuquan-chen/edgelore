# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# Any OpenAI-compatible endpoint works (official OpenAI, relays, self-hosted).

# --- chat (gate / extract) ---
OPENAI_API_KEY=
# API base (omit for official api.openai.com); e.g. https://api.dogrouter.ai/v1
OPENAI_BASE_URL=
# Model name exactly as your endpoint names it, e.g. deepseek-v4-flash-0731
EDGELORE_MODEL=

# --- embeddings (retrieval; may be a DIFFERENT vendor than chat) ---
# Falls back to OPENAI_API_KEY / OPENAI_BASE_URL when unset.
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
# e.g. qwen3.7-text-embedding (relay), text-embedding-3-small (OpenAI), bge-m3 (Ollama)
EDGELORE_EMBEDDING_MODEL=
# Declared vector dimensions, must match the model (qwen3.7-text-embedding = 1024)
EDGELORE_EMBEDDING_DIMENSIONS=
